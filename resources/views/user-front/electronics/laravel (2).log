    \"<span class=sf-dump-key>cname_record_section_title</span>\" => \"<span class=sf-dump-str title=\"41 characters\">Read Before Sending Custom Domain Request</span>\"
    \"<span class=sf-dump-key>cname_record_section_text</span>\" => \"\"\"
      <span class=sf-dump-str title=\"6920 characters\">&lt;p&gt;Before submitting a custom domain request, you must first point your custom domain to our domain (&lt;strong&gt;ecommet.xyz&lt;/strong&gt;).&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"6920 characters\">&lt;p&gt;To point custom domain to ecommet.xyz, you need to add the necessary DNS records in your custom domain form your domain registrar&#8217;s control panel (e.g., Namecheap, GoDaddy, Bluehost, etc.).&lt;br /&gt;&lt;br /&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
