<IfModule mod_rewrite.c>
    # Block sensitive files from direct download
    <FilesMatch "\.(sql|log|csv|env|sh|git|bak|json|lock)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Block direct access to test scripts
    <FilesMatch "^(test_|check_|export_|reset_).*\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    Options -Indexes
    RewriteEngine On

    # Block sensitive files
    <FilesMatch ^\.env>
        Require all denied
    </FilesMatch>

    # WhatsApp Bulk Platform Routing (Strict Host Guard: ONLY whatsappbulk.* or whatsapp.*)
    # If the domain is NOT whatsappbulk.* and NOT whatsapp.*, SKIP the WhatsApp rules completely!
    RewriteCond %{HTTP_HOST} !^whatsappbulk\. [NC]
    RewriteCond %{HTTP_HOST} !^whatsapp\. [NC]
    RewriteRule ^ - [S=2]

    # Rule 1: Serve existing static assets for WhatsApp Bulk directly
    RewriteCond %{REQUEST_URI} !^/whatsappautomationtool/Install/public/
    RewriteCond %{DOCUMENT_ROOT}/whatsappautomationtool/Install/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ whatsappautomationtool/Install/public/$1 [L]

    # Rule 2: Pass all other WhatsApp Bulk requests to WhatsApp Laravel index.php
    RewriteCond %{REQUEST_URI} !^/whatsappautomationtool/Install/public/
    RewriteRule ^(.*)$ whatsappautomationtool/Install/public/index.php [L]

    # ─────────────────────────────────────────────────────────────────────────────
    # LaunchShop and WebsiteBuilder Standard Routing (Untouched and 100% Protected)
    # ─────────────────────────────────────────────────────────────────────────────
    # Send the homepage to Laravel public directory
    RewriteRule ^$ public/ [L]

    # Route other requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
